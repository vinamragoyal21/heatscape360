# Base URL of the deployed backend API (no trailing slash).
# Local dev default matches the backend's default port.
VITE_API_BASE_URL=http://localhost:8080

# Optional. If you set a Google Maps JavaScript API key here (with Maps
# JavaScript API, Places API and Directions API enabled and HTTP-referrer
# restricted to your domain), see frontend/src/components/map/README.md for
# how to wire up the Google Maps provider ("Link with Google API"). The app
# works fully without this, using free OpenStreetMap-based maps/search/routing.
VITE_GOOGLE_MAPS_API_KEY=
