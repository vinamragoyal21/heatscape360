# Port the API listens on (Railway sets this automatically in production)
PORT=8080

# Comma-separated list of origins allowed to call this API.
# Add your Vercel URL(s) here after you deploy the frontend, e.g.:
# CORS_ORIGIN=https://heatscape360.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- Optional keys (the app works with sensible fallbacks if these are empty) ----

# If set, the AI Assistant uses Anthropic's Claude API for open-ended answers.
# Get one at https://console.anthropic.com/  (Without it, the assistant still
# works using a built-in heat-safety knowledge base.)
ANTHROPIC_API_KEY=

# Optional alternative for the AI assistant.
OPENAI_API_KEY=

# Optional: a custom Overpass API mirror if the default is slow/rate-limited.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Optional: a self-hosted OSRM server. Defaults to the public demo server,
# which is rate-limited and fine for development/demo, NOT for heavy production
# traffic. See DEPLOYMENT.md for how to point this at your own OSRM instance.
OSRM_URL=https://router.project-osrm.org
